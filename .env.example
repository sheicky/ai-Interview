# Copy to .env.local (gitignored) and fill in.
# Shared secret ElevenLabs sends as the X-Shared-Secret header on /api/llm.
SHARED_SECRET=change-me-to-a-long-random-string

# Pinecone (RAG store + server-side embeddings).
# PINECONE_API_KEY=pcsk_...
# PINECONE_INDEX=interview-docs

# OpenRouter (model gateway for the interview brain). Pick any slug from
# https://openrouter.ai/models — a bad slug surfaces as an OpenRouter 502.
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Reply length caps. Without these, OpenRouter reserves the model's full default
# max output (~65k tokens) per request and returns a 402 the moment your account
# balance can't cover that reservation — the voice agent then goes silent.
# OPENROUTER_MAX_TOKENS=1024          # per voice/chat interview turn
# OPENROUTER_REPORT_MAX_TOKENS=4096   # per one-shot report generation
# Free model to retry on when the primary errors (402 out-of-credits, provider
# 5xx) so the interview never goes silent. Set to "" to disable the fallback.
# OPENROUTER_FALLBACK_MODEL=google/gemma-4-31b-it:free
# Optional attribution headers:
# OPENROUTER_SITE_URL=https://your-app.example
# OPENROUTER_APP_NAME=AI Interview Practice

# Database. Local dev/test defaults to a file (.data/app.db) — no value needed.
# Production (Vercel): a Turso libSQL database.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=...

# Added in later tasks:
# ElevenLabs Conversational AI (voice interview)
# ELEVENLABS_API_KEY=sk_...
# ELEVENLABS_AGENT_ID=agent_...
# PUBLIC_URL=https://your-app.vercel.app   # used by scripts/setup-agent.ts
